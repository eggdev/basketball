{
  "name": "@fantasy-basketball/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@vercel/functions": "3.9.8",
    "better-auth": "1.7.5",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "tslib": "^2.3.0"
  },
  "nx": {
    "name": "auth",
    "sourceRoot": "packages/auth/src",
    "projectType": "library",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/packages/auth",
          "main": "packages/auth/src/index.ts",
          "tsConfig": "packages/auth/tsconfig.lib.json",
          "assets": [
            "packages/auth/*.md"
          ]
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bunx tsc -p packages/auth/tsconfig.lib.json --noEmit",
          "cwd": "."
        }
      },
      "auth-db-migrate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bun --env-file=.env.local packages/auth/scripts/migrate.ts",
          "cwd": "."
        }
      }
    }
  }
}
