{
  "name": "fantasy-basketball",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run web:build",
    "check": "bun run typecheck && bun run test && bun run lint && bun run test:python",
    "data:import": "nx run importer:data-import -- --commit",
    "data:validate": "nx run importer:data-import",
    "dev": "nx run web:dev",
    "dev:agent": "nx run agent:dev",
    "dev:agent:ui": "bunx eve dev",
    "dev:web": "nx run web:dev",
    "lint": "nx run-many -t lint",
    "production:import": "nx run importer:production-import -- --commit",
    "production:validate": "nx run importer:production-import",
    "scoring:import": "nx run importer:scoring-import -- --commit",
    "scoring:validate": "nx run importer:scoring-import",
    "test": "nx run-many -t test -- --run",
    "test:python": "PYTHONPATH=src python3 -m unittest discover -s tests -v",
    "typecheck": "nx run-many -t typecheck"
  },
  "dependencies": {
    "@effect/sql-pg": "0.53.0",
    "@fantasy-basketball/auth": "workspace:*",
    "@fantasy-basketball/database": "workspace:*",
    "@fantasy-basketball/fantasy": "workspace:*",
    "@vercel/connect": "2.2.0",
    "@vercel/functions": "3.9.8",
    "ai": "^7.0.105",
    "better-auth": "1.7.5",
    "effect": "3.22.2",
    "eve": "0.58.1",
    "kysely": "0.29.6",
    "next": "~16.1.6",
    "pg": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "^27.1.0",
    "nx": "23.2.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.3",
    "vercel": "59.20.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.9"
}
