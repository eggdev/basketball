{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "agent",
  "projectType": "application",
  "sourceRoot": "agent",
  "tags": ["type:agent"],
  "implicitDependencies": ["fantasy"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/.output"],
      "options": {
        "command": "bunx eve build",
        "cwd": "."
      }
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eve dev --no-ui",
        "cwd": "."
      }
    },
    "info": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eve info",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc -p tsconfig.agent.json --noEmit",
        "cwd": "."
      }
    }
  }
}
